<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>downloadx</title>
<style>
  :root {
    --bg: #14161a; --panel: #1c1f26; --panel2: #232730; --line: #2e3440;
    --fg: #e6e9ef; --dim: #8b93a7; --accent: #4c9aff; --ok: #3fb950;
    --warn: #d29922; --err: #f85149; --radius: 8px;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; }
  body {
    background: var(--bg); color: var(--fg); font: 13px/1.45 "Segoe UI", system-ui, sans-serif;
    display: flex; flex-direction: column; overflow: hidden;
  }
  header {
    display: flex; align-items: center; gap: 12px; padding: 10px 14px;
    background: var(--panel); border-bottom: 1px solid var(--line); flex: 0 0 auto;
  }
  header h1 { font-size: 15px; margin: 0; font-weight: 600; letter-spacing: .2px; }
  header .spacer { flex: 1; }
  .stat { color: var(--dim); font-variant-numeric: tabular-nums; }
  .stat b { color: var(--fg); font-weight: 600; }
  button {
    background: var(--panel2); color: var(--fg); border: 1px solid var(--line);
    border-radius: 6px; padding: 5px 10px; cursor: pointer; font: inherit;
  }
  button:hover { background: #2b3140; border-color: #3d4657; }
  button.primary { background: #1d4ed8; border-color: #2563eb; }
  button.primary:hover { background: #2563eb; }
  button.danger:hover { background: #4a1f22; border-color: var(--err); }
  button:disabled { opacity: .45; cursor: default; }
  main { flex: 1; display: grid; grid-template-columns: 1fr 340px; min-height: 0; }
  #left { display: flex; flex-direction: column; min-width: 0; }
  #addbar {
    display: flex; gap: 8px; padding: 10px 14px; background: var(--panel);
    border-bottom: 1px solid var(--line);
  }
  #addbar input[type=text] {
    flex: 1; background: var(--bg); border: 1px solid var(--line); color: var(--fg);
    border-radius: 6px; padding: 6px 10px; font: inherit; min-width: 0;
  }
  #addbar input:focus { outline: none; border-color: var(--accent); }
  #list { flex: 1; overflow: auto; }
  #addopts { background: var(--panel); border-bottom: 1px solid var(--line); padding: 6px 14px; }
  #addopts summary { color: var(--dim); font-size: 11px; }
  #addopts .addopts-body { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  #addopts label { color: var(--dim); font-size: 11px; display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 160px; }
  #addopts input {
    background: var(--bg); border: 1px solid var(--line); color: var(--fg);
    border-radius: 6px; padding: 5px 8px; font: inherit; width: 100%;
  }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  th {
    position: sticky; top: 0; background: var(--panel2); color: var(--dim);
    font-weight: 600; font-size: 12px; z-index: 1;
  }
  tbody tr:hover { background: #1a1e25; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  td.grip { cursor: grab; color: var(--dim); width: 22px; user-select: none; }
  tr[draggable] { cursor: default; }
  .name { max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .url { color: var(--dim); font-size: 11px; max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bar { height: 6px; background: #2a3040; border-radius: 3px; overflow: hidden; min-width: 90px; }
  .bar > i { display: block; height: 100%; background: var(--accent); transition: width .2s; }
  .bar.done > i { background: var(--ok); }
  .bar.unknown > i { background: repeating-linear-gradient(45deg, #46506a 0 5px, #2a3040 5px 10px); }
  .bar.err > i { background: var(--err); }
  .pill {
    display: inline-block; padding: 1px 7px; border-radius: 10px; font-size: 11px;
    background: #2a3040; color: var(--dim); white-space: nowrap;
  }
  .pill.downloading, .pill.connecting { background: #16324f; color: #79b8ff; }
  .pill.complete { background: #12331c; color: #56d364; }
  .pill.error { background: #3d1619; color: #ff7b72; }
  .pill.paused { background: #3a2f12; color: #e3b341; }
  .pill.queued { background: #2a3040; color: var(--dim); }
  .row-actions { display: flex; gap: 4px; }
  .row-actions button { padding: 2px 7px; font-size: 12px; }
  #side {
    border-left: 1px solid var(--line); background: var(--panel);
    display: flex; flex-direction: column; min-height: 0;
  }
  .tabs { display: flex; border-bottom: 1px solid var(--line); flex: 0 0 auto; }
  .tabs button {
    flex: 1; border: none; border-radius: 0; background: transparent; padding: 9px;
    color: var(--dim); border-bottom: 2px solid transparent;
  }
  .tabs button.active { color: var(--fg); border-bottom-color: var(--accent); background: var(--panel2); }
  .tabbody { flex: 1; overflow: auto; padding: 12px; min-height: 0; }
  .field { margin-bottom: 10px; }
  .field label { display: block; color: var(--dim); font-size: 11px; margin-bottom: 3px; }
  .field input, .field select {
    width: 100%; background: var(--bg); border: 1px solid var(--line); color: var(--fg);
    border-radius: 6px; padding: 5px 8px; font: inherit;
  }
  .field input[type=checkbox] { width: auto; }
  .checkline { display: flex; align-items: center; gap: 7px; margin-bottom: 8px; }
  .checkline label { color: var(--fg); font-size: 12px; margin: 0; }
  #logbox {
    font: 11px/1.5 Consolas, monospace; white-space: pre-wrap; word-break: break-all;
    color: var(--dim);
  }
  .empty { padding: 40px 20px; text-align: center; color: var(--dim); }
  #toast {
    position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%);
    background: var(--panel2); border: 1px solid var(--line); border-left: 3px solid var(--accent);
    padding: 9px 14px; border-radius: 6px; opacity: 0; transition: opacity .2s;
    pointer-events: none; max-width: 70vw;
  }
  #toast.show { opacity: 1; }
  #toast.err { border-left-color: var(--err); }
  #toast.ok { border-left-color: var(--ok); }
  details summary { cursor: pointer; color: var(--dim); }
</style>
</head>
<body>
<header>
  <h1>downloadx</h1>
  <span class="stat" id="summary">—</span>
  <span class="spacer"></span>
  <button id="btnPauseAll" title="Pause the whole queue">Pause all</button>
  <button id="btnResumeAll" title="Resume the whole queue">Resume all</button>
  <button id="btnClearDone" title="Remove finished downloads from the list">Clear done</button>
</header>

<main>
  <section id="left">
    <div id="addbar">
      <input type="text" id="urlInput" placeholder="Paste a URL and press Enter (http, https, ftp, m3u8, mpd)" spellcheck="false">
      <button class="primary" id="btnAdd">Add</button>
    </div>
    <details id="addopts">
      <summary>Save as / folder / connections (optional)</summary>
      <div class="addopts-body">
        <label>File name <input type="text" id="addName" placeholder="from the URL or Content-Disposition" spellcheck="false"></label>
        <label>Folder <input type="text" id="addDir" placeholder="the default folder from Settings" spellcheck="false"></label>
        <label>Connections <input type="number" id="addConnections" min="1" max="32" placeholder="from Settings"></label>
      </div>
    </details>
    <div id="list"><div class="empty">No downloads yet.</div></div>
  </section>

  <aside id="side">
    <div class="tabs">
      <button class="active" data-tab="settings">Settings</button>
      <button data-tab="schedule">Schedule</button>
      <button data-tab="discover">Discover</button>
      <button data-tab="history">History</button>
      <button data-tab="capture">Capture</button>
      <button data-tab="log">Log</button>
    </div>
    <div class="tabbody" id="tab-settings">
      <div class="field"><label>Default folder</label><input type="text" id="cfg-defaultDir"></div>
      <div class="field"><label>Max concurrent downloads</label><input type="number" id="cfg-maxConcurrentDownloads" min="1" max="32"></div>
      <div class="field"><label>Connections per download (1-32)</label><input type="number" id="cfg-maxConnections" min="1" max="32"></div>
      <div class="field"><label>Segment size</label><input type="text" id="cfg-segmentBytes"></div>
      <div class="field"><label>Speed limit (bytes/s, 0 = unlimited)</label><input type="number" id="cfg-speedLimit" min="0"></div>
      <div class="field"><label>Proxy (http://host:port or socks5://user:pass@host:port)</label><input type="text" id="cfg-proxy" placeholder="leave empty for a direct connection" spellcheck="false"></div>
      <div class="field"><label>When a file already exists</label>
        <select id="cfg-overwriteExisting">
          <option value="rename">Rename the new file</option>
          <option value="overwrite">Overwrite it</option>
          <option value="skip">Skip the download</option>
        </select>
      </div>
      <div class="checkline"><input type="checkbox" id="cfg-categorizeByType"><label for="cfg-categorizeByType">Sort into folders by file type</label></div>
      <div class="checkline"><input type="checkbox" id="cfg-monitorClipboard"><label for="cfg-monitorClipboard">Watch the clipboard for URLs</label></div>
      <div class="checkline"><input type="checkbox" id="cfg-insecure"><label for="cfg-insecure">Skip TLS certificate checks</label></div>
      <div class="field"><label>ffmpeg path (empty = search PATH; used to merge audio+video)</label><input type="text" id="cfg-ffmpegPath" placeholder="ffmpeg"></div>
      <div id="cap-line" style="color:var(--dim);font-size:11px;margin-bottom:10px"></div>
      <button class="primary" id="btnSaveCfg">Save settings</button>
    </div>
    <div class="tabbody" id="tab-schedule" style="display:none">
      <div class="field"><label>Time (HH:MM, 24h)</label><input type="text" id="sched-at" placeholder="02:00"></div>
      <div class="field"><label>Action</label>
        <select id="sched-action">
          <option value="resume">Resume the queue</option>
          <option value="pause">Pause the queue</option>
          <option value="clear-completed">Clear finished</option>
        </select>
      </div>
      <div class="field"><label>Name</label><input type="text" id="sched-name" placeholder="night run"></div>
      <button class="primary" id="btnAddSched">Add schedule</button>
      <div id="schedList" style="margin-top:14px"></div>
    </div>
    <div class="tabbody" id="tab-discover" style="display:none">
      <div class="field"><label>Page URL</label><input type="text" id="disc-url" placeholder="https://example.com/watch/123" spellcheck="false"></div>
      <div style="display:flex;gap:6px;margin-bottom:12px">
        <button class="primary" id="btnSniff" style="flex:1">Find streams</button>
        <button id="btnGrab" style="flex:1">List links</button>
      </div>
      <div id="disc-status" style="color:var(--dim);font-size:12px;margin-bottom:10px"></div>
      <div id="disc-results"></div>
    </div>
    <div class="tabbody" id="tab-capture" style="display:none">
      <div id="cap-status" style="font-size:12px;color:var(--dim);margin-bottom:10px"></div>
      <div style="display:flex;gap:6px;margin-bottom:10px">
        <button class="primary" id="btnCapToggle" style="flex:1">Start</button>
        <button id="btnCapClear">Clear</button>
      </div>
      <div class="field"><label>Mode</label>
        <select id="cap-mode">
          <option value="tunnel">tunnel — see destinations only</option>
          <option value="mitm">mitm — decrypt HTTPS (needs CA)</option>
        </select>
      </div>
      <div style="display:flex;gap:6px;margin-bottom:8px">
        <button id="btnCaCreate" style="flex:1">Create CA</button>
        <button id="btnCaDestroy" style="flex:1">Remove CA</button>
      </div>
      <div class="checkline"><input type="checkbox" id="cap-autoqueue"><label for="cap-autoqueue">Auto-queue high-confidence captures</label></div>
      <div id="cap-list"></div>
    </div>
    <div class="tabbody" id="tab-history" style="display:none">
      <div class="field"><label>Filter</label><input type="text" id="hist-q" placeholder="part of a URL or file name" spellcheck="false"></div>
      <div style="display:flex;gap:6px;margin-bottom:10px">
        <button class="primary" id="btnHistRefresh" style="flex:1">Search</button>
        <button id="btnHistClear" title="Delete the whole history. This cannot be undone.">Clear</button>
      </div>
      <div id="hist-status" style="color:var(--dim);font-size:12px;margin-bottom:10px"></div>
      <div id="hist-list"></div>
    </div>
    <div class="tabbody" id="tab-log" style="display:none">
      <div id="logbox">(no log lines yet)</div>
    </div>
  </aside>
</main>

<div id="toast"></div>

<script>
const boot = window.__DOWNLOADX__ || {};
let TOKEN = boot.token || "";
const state = { tasks: [], config: null, filter: "", timer: null };

function api(path, opts) {
  const o = Object.assign({}, opts || {});
  o.headers = Object.assign({ "x-downloadx-token": TOKEN }, o.headers || {});
  if (o.body && typeof o.body !== "string") {
    o.body = JSON.stringify(o.body);
    o.headers["content-type"] = "application/json";
  }
  return fetch(path, o).then(async (r) => {
    const text = await r.text();
    let data = null;
    try { data = JSON.parse(text); } catch { data = { raw: text }; }
    if (!r.ok) throw new Error((data && data.error) || ("HTTP " + r.status));
    return data;
  });
}

function toast(msg, kind) {
  const el = document.getElementById("toast");
  el.textContent = msg;
  el.className = "show " + (kind || "");
  clearTimeout(el._t);
  el._t = setTimeout(() => { el.className = ""; }, 2600);
}

function fmtBytes(n) {
  if (n === null || n === undefined || !isFinite(n)) return "—";
  const u = ["B", "KB", "MB", "GB", "TB"];
  let i = 0, v = Number(n);
  while (v >= 1024 && i < u.length - 1) { v /= 1024; i++; }
  return (i === 0 ? v : v.toFixed(1)) + " " + u[i];
}
function fmtSpeed(n) { return n > 0 ? fmtBytes(n) + "/s" : "—"; }
function fmtDur(s) {
  if (!isFinite(s) || s <= 0) return "—";
  s = Math.round(s);
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
  const p = (x) => String(x).padStart(2, "0");
  return h ? h + ":" + p(m) + ":" + p(sec) : p(m) + ":" + p(sec);
}
function esc(s) {
  return String(s === null || s === undefined ? "" : s)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function render() {
  const list = document.getElementById("list");
  const tasks = state.tasks.filter((t) => {
    if (!state.filter) return true;
    const q = state.filter.toLowerCase();
    return (t.filename || "").toLowerCase().includes(q) || (t.url || "").toLowerCase().includes(q);
  });

  if (!tasks.length) {
    list.innerHTML = '<div class="empty">' + (state.tasks.length ? "No matches." : "No downloads yet.") + "</div>";
    return;
  }

  const rows = tasks.map((t, idx) => {
    // A streamed transfer has no declared length, so percent is null rather
    // than a number. Drawing 0% would read as "not started" and 100% as
    // "finished", so the bar is replaced by the received byte count.
    const known = t.lengthKnown !== false && t.totalBytes !== null && t.totalBytes !== undefined;
    const pct = known ? (t.percent || 0) : null;
    const cls = t.status === "complete" ? "done" : t.status === "error" ? "err" : "";
    const running = t.status === "downloading" || t.status === "connecting";
    const name = esc(t.filename || t.url.split("/").pop() || t.url);
    let detail = "";
    if (t.status === "error") detail = esc(t.error || "failed");
    else if (running) detail = fmtSpeed(t.speed) + (known && t.speed ? "  ETA " + fmtDur((t.totalBytes - t.downloadedBytes) / t.speed) : "");
    else if (t.status === "complete") detail = t.sha256 ? t.sha256.slice(0, 12) : "done";
    else if (t.status === "paused") detail = fmtBytes(t.downloadedBytes) + " kept for resume";

    const progress = pct === null
      ? '<div class="bar unknown"><i style="width:100%"></i></div>' +
        '<div style="font-size:11px;color:var(--dim);margin-top:3px">' +
        fmtBytes(t.downloadedBytes) + " received · total length unknown</div>"
      : '<div class="bar ' + cls + '"><i style="width:' + pct.toFixed(1) + '%"></i></div>' +
        '<div style="font-size:11px;color:var(--dim);margin-top:3px">' + fmtBytes(t.downloadedBytes) + " / " + fmtBytes(t.totalBytes) + "  " + pct.toFixed(0) + "%</div>";

    const act = [];
    if (running || t.status === "queued") act.push('<button data-a="pause" data-id="' + t.id + '" title="Stop and keep the partial file">Pause</button>');
    // A failed task gets an explicit retry, so the user does not have to guess
    // whether "Resume" also clears the error.
    if (t.status === "error") act.push('<button data-a="retry" data-id="' + t.id + '" title="Try again from where it stopped">Retry</button>');
    if (t.status === "paused") act.push('<button data-a="start" data-id="' + t.id + '" title="Continue from the bytes already on disk">Resume</button>');
    act.push('<button class="danger" data-a="remove" data-id="' + t.id + '" title="Remove from the list (the file is kept)">Del</button>');

    return '<tr draggable="true" data-id="' + t.id + '" data-idx="' + idx + '">' + '<td class="grip" title="Drag to reorder">⠿</td>' +
      '<td><div class="name" title="' + esc(t.url) + '">' + name + "</div>" +
      (t.filename ? '<div class="url">' + esc(t.url) + "</div>" : "") + "</td>" +
      '<td><span class="pill ' + t.status + '">' + t.status + "</span></td>" +
      '<td class="num" style="min-width:130px">' + progress + "</td>" +
      '<td style="font-size:11px;color:var(--dim)">' + detail + "</td>" +
      '<td><div class="row-actions">' + act.join("") + "</div></td>" +
      "</tr>";
  }).join("");

  list.innerHTML = "<table><thead><tr><th></th><th>Name</th><th>Status</th><th>Progress</th><th>Detail</th><th></th></tr></thead><tbody>" + rows + "</tbody></table>";
  wireDrag(list);
}

async function refresh() {
  try {
    const [tasks, status] = await Promise.all([api("/api/tasks"), api("/api/status")]);
    state.tasks = tasks.tasks || [];
    const q = status.queue || {};
    document.getElementById("summary").innerHTML =
      "<b>" + (q.active || 0) + "</b>/" + (q.capacity || 0) + " active · " +
      "<b>" + (q.queued || 0) + "</b> queued · " +
      "<b>" + (q.complete || 0) + "</b> done" +
      (q.error ? ' · <span style="color:var(--err)">' + q.error + " failed</span>" : "") +
      (q.totalSpeed ? " · " + fmtSpeed(q.totalSpeed) : "");
    if (!state.config) { state.config = status.config; fillConfig(status.config); }
    if (status.capabilities) {
      const cap = document.getElementById("cap-line");
      if (cap) cap.textContent = "ffmpeg: " + (status.capabilities.ffmpeg || "not found (stream merging disabled)") +
        "  ·  clipboard watch: " + (status.capabilities.clipboardWatch ? "on" : "off");
    }
    render();
  } catch (err) {
    document.getElementById("summary").textContent = "disconnected: " + err.message;
  }
}

let dragId = null;
function wireDrag(list) {
  list.querySelectorAll("tr[data-id]").forEach((tr) => {
    tr.addEventListener("dragstart", (e) => {
      dragId = tr.dataset.id;
      tr.style.opacity = "0.4";
      try { e.dataTransfer.setData("text/plain", dragId); } catch { /* older engines */ }
      e.dataTransfer.effectAllowed = "move";
    });
    tr.addEventListener("dragend", () => { tr.style.opacity = ""; dragId = null; });
    tr.addEventListener("dragover", (e) => { e.preventDefault(); tr.style.borderTop = "2px solid var(--accent)"; });
    tr.addEventListener("dragleave", () => { tr.style.borderTop = ""; });
    tr.addEventListener("drop", async (e) => {
      e.preventDefault();
      tr.style.borderTop = "";
      const from = dragId || e.dataTransfer.getData("text/plain");
      const to = tr.dataset.id;
      if (!from || from === to) return;
      // The target position is read from the rows on screen, not from the
      // cached task list: the list re-renders every couple of seconds, so the
      // stored order can already be out of step with what the user is
      // dragging in. Using the stale copy dropped the row somewhere else.
      const rendered = [...list.querySelectorAll("tr[data-id]")].map((row) => row.dataset.id);
      const toIdx = rendered.indexOf(to);
      if (toIdx < 0) return;
      try {
        await api("/api/tasks/" + encodeURIComponent(from) + "/move", { method: "POST", body: { toIndex: toIdx } });
        await refresh();
        toast("Moved", "ok");
      } catch (err) { toast("Reorder failed: " + err.message, "err"); }
    });
  });
}

function fillConfig(c) {
  const set = (id, v) => { const el = document.getElementById(id); if (el) { if (el.type === "checkbox") el.checked = !!v; else el.value = v === null || v === undefined ? "" : v; } };
  set("cfg-defaultDir", c.defaultDir);
  set("cfg-maxConcurrentDownloads", c.maxConcurrentDownloads);
  set("cfg-maxConnections", c.maxConnections);
  set("cfg-segmentBytes", c.segmentBytes);
  set("cfg-speedLimit", c.speedLimit);
  set("cfg-proxy", c.proxy);
  set("cfg-overwriteExisting", c.overwriteExisting);
  set("cfg-categorizeByType", c.categorizeByType);
  set("cfg-monitorClipboard", c.monitorClipboard);
  set("cfg-insecure", c.insecure);
  set("cfg-ffmpegPath", c.ffmpegPath);
}

async function addUrl() {
  const input = document.getElementById("urlInput");
  const url = input.value.trim();
  if (!url) return;
  // The optional fields let one download go somewhere other than the default
  // folder without touching the global setting, which is what a user expects
  // after pasting a single link.
  const dir = document.getElementById("addDir").value.trim();
  const filename = document.getElementById("addName").value.trim();
  const connections = Number(document.getElementById("addConnections").value) || undefined;
  const body = { url };
  if (dir) body.dir = dir;
  if (filename) body.filename = filename;
  if (connections) body.connections = connections;
  try {
    const r = await api("/api/tasks", { method: "POST", body });
    input.value = "";
    toast("Added " + (r.task.filename || url), "ok");
    refresh();
  } catch (err) { toast("Add failed: " + err.message, "err"); }
}

async function act(action, id, opts) {
  try {
    if (action === "remove") {
      const suffix = opts && opts.deleteFile ? "?deleteFile=1" : "";
      await api("/api/tasks/" + id + suffix, { method: "DELETE" });
      toast(opts && opts.deleteFile ? "Task and file removed" : "Task removed (file kept)", "ok");
    } else {
      await api("/api/tasks/" + id + "/" + action, { method: "POST" });
    }
    refresh();
  } catch (err) { toast(err.message, "err"); }
}

document.getElementById("btnAdd").onclick = addUrl;
document.getElementById("urlInput").addEventListener("keydown", (e) => { if (e.key === "Enter") addUrl(); });
document.getElementById("addName").addEventListener("keydown", (e) => { if (e.key === "Enter") addUrl(); });
document.getElementById("addDir").addEventListener("keydown", (e) => { if (e.key === "Enter") addUrl(); });
document.getElementById("list").addEventListener("click", (e) => {
  const b = e.target.closest("button[data-a]");
  if (!b) return;
  // Del asks once whether the file should go too: deleting a finished 4 GB
  // download from the list while leaving it on disk (or the reverse) are both
  // reasonable, but neither should happen by surprise.
  if (b.dataset.a === "remove") {
    const withFile = confirm("Remove this task from the list?\n\nOK = also delete the downloaded file\nCancel = keep the file on disk");
    act("remove", b.dataset.id, { deleteFile: withFile });
    return;
  }
  act(b.dataset.a, b.dataset.id);
});
document.getElementById("btnPauseAll").onclick = async () => { await api("/api/queue/pause", { method: "POST" }); refresh(); };
document.getElementById("btnResumeAll").onclick = async () => { await api("/api/queue/resume", { method: "POST" }); refresh(); };
document.getElementById("btnClearDone").onclick = async () => {
  const r = await api("/api/queue/clear-completed", { method: "POST" });
  toast("Removed " + r.removed + " finished", "ok"); refresh();
};

document.getElementById("btnSaveCfg").onclick = async () => {
  const body = {
    defaultDir: document.getElementById("cfg-defaultDir").value.trim(),
    maxConcurrentDownloads: Number(document.getElementById("cfg-maxConcurrentDownloads").value) || 1,
    maxConnections: Number(document.getElementById("cfg-maxConnections").value) || 8,
    segmentBytes: Number(document.getElementById("cfg-segmentBytes").value) || 8388608,
    speedLimit: Number(document.getElementById("cfg-speedLimit").value) || 0,
    proxy: document.getElementById("cfg-proxy").value.trim(),
    overwriteExisting: document.getElementById("cfg-overwriteExisting").value,
    categorizeByType: document.getElementById("cfg-categorizeByType").checked,
    monitorClipboard: document.getElementById("cfg-monitorClipboard").checked,
    insecure: document.getElementById("cfg-insecure").checked,
    ffmpegPath: document.getElementById("cfg-ffmpegPath").value.trim(),
  };
  try { const r = await api("/api/config", { method: "PATCH", body }); state.config = r.config; toast("Settings saved", "ok"); }
  catch (err) { toast(err.message, "err"); }
};

document.querySelectorAll(".tabs button").forEach((b) => {
  b.onclick = () => {
    document.querySelectorAll(".tabs button").forEach((x) => x.classList.toggle("active", x === b));
    for (const name of ["settings", "schedule", "discover", "capture", "log"]) {
      document.getElementById("tab-" + name).style.display = name === b.dataset.tab ? "" : "none";
    }
    if (b.dataset.tab === "log") loadLog();
    if (b.dataset.tab === "schedule") loadSchedules();
    if (b.dataset.tab === "capture") capRefresh();
    if (b.dataset.tab === "history") loadHistory();
  };
});

async function sniffPage() {
  const url = document.getElementById("disc-url").value.trim();
  const status = document.getElementById("disc-status");
  const results = document.getElementById("disc-results");
  if (!url) { toast("Enter a page URL first", "err"); return; }
  status.textContent = "scanning...";
  results.innerHTML = "";
  try {
    const r = await api("/api/sniff", { method: "POST", body: { url } });
    if (r.error) { status.textContent = "error: " + r.error; return; }
    const list = r.candidates || [];
    if (!list.length) { status.textContent = "no media streams found on " + (r.finalUrl || url); return; }
    status.textContent = list.length + " candidate(s) on " + (r.finalUrl || url);
    for (const c of list) {
      const info = await api("/api/inspect-stream", { method: "POST", body: { url: c.url } });
      const row = document.createElement("div");
      row.style.cssText = "border:1px solid var(--line);border-radius:6px;padding:8px;margin-bottom:8px";
      let detail = c.kind;
      if (info.master && info.variants && info.variants.length) {
        detail += " · master · " + info.variants.length + " variant(s) · best " + ((info.best && info.best.resolution) || "?");
      } else if (info.segmentCount !== undefined && info.segmentCount !== null) {
        detail += " · " + info.segmentCount + " segment(s)" + (info.live ? " · LIVE" : "") + (info.encrypted ? " · encrypted" : "");
      } else if (info.representations) {
        detail += " · " + info.representations.length + " representation(s)";
      } else if (info.totalBytes) {
        detail += " · " + fmtBytes(info.totalBytes);
      }
      const label = document.createElement("div");
      label.style.cssText = "font-size:11px;color:var(--dim);word-break:break-all;margin-bottom:6px";
      label.textContent = detail;
      const urlLine = document.createElement("div");
      urlLine.style.cssText = "font-size:11px;color:var(--dim);word-break:break-all;margin-bottom:6px";
      urlLine.textContent = c.url;
      const btn = document.createElement("button");
      btn.textContent = "Download";
      btn.onclick = async () => {
        btn.disabled = true;
        try {
          await api("/api/tasks", { method: "POST", body: { url: c.url, kind: c.kind } });
          btn.textContent = "Queued";
          toast("Queued " + c.kind + " stream", "ok");
          refresh();
        } catch (err) { btn.disabled = false; toast(err.message, "err"); }
      };
      row.appendChild(label); row.appendChild(urlLine); row.appendChild(btn);
      results.appendChild(row);
    }
  } catch (err) { status.textContent = "error: " + err.message; }
}

async function grabLinks() {
  const url = document.getElementById("disc-url").value.trim();
  const status = document.getElementById("disc-status");
  const results = document.getElementById("disc-results");
  if (!url) { toast("Enter a page URL first", "err"); return; }
  status.textContent = "collecting links...";
  results.innerHTML = "";
  try {
    const r = await api("/api/grab", { method: "POST", body: { url } });
    if (r.error) { status.textContent = "error: " + r.error; return; }
    const links = r.links || [];
    status.textContent = links.length + " resource(s) on " + (r.finalUrl || url);
    const bar = document.createElement("div");
    bar.style.cssText = "margin-bottom:10px";
    const all = document.createElement("button");
    all.textContent = "Queue all " + links.length;
    all.className = "primary";
    all.onclick = async () => {
      all.disabled = true;
      try {
        const q = await api("/api/grab", { method: "POST", body: { url, queue: true } });
        toast("Queued " + q.queued + " resource(s)", "ok");
        all.textContent = "Queued " + q.queued;
        refresh();
      } catch (err) { all.disabled = false; toast(err.message, "err"); }
    };
    bar.appendChild(all);
    results.appendChild(bar);
    for (const l of links) {
      const row = document.createElement("div");
      row.style.cssText = "font-size:11px;color:var(--dim);word-break:break-all;margin-bottom:4px";
      row.textContent = "[" + (l.category || l.tag) + "] " + l.url;
      results.appendChild(row);
    }
  } catch (err) { status.textContent = "error: " + err.message; }
}

async function capRefresh() {
  try {
    const r = await api("/api/proxy/status");
    const st = r.proxy || {};
    const ca = r.ca || {};
    const running = Boolean(st.running);
    document.getElementById("btnCapToggle").textContent = running ? "Stop" : "Start";
    document.getElementById("cap-status").innerHTML =
      (running
        ? "running on <b>" + st.host + ":" + st.port + "</b> (" + st.mode + ")"
        : "stopped") +
      "<br>captured: " + ((st.stats && st.stats.captured) || 0) +
      " · requests: " + ((st.stats && st.stats.requests) || 0) +
      " · tunnels: " + ((st.stats && st.stats.tunnels) || 0) +
      "<br>CA: " + (ca.installed ? "created" : "not created") +
      (running ? '<br><span style="font-family:monospace">curl -x http://' + st.host + ":" + st.port + ' https://example.com/file.zip</span>' : "");
    const cfg = state.config || {};
    if (cfg.captureProxy && document.activeElement !== document.getElementById("cap-mode")) {
      document.getElementById("cap-mode").value = cfg.captureProxy.mode || "tunnel";
    }
    const list = await api("/api/proxy/captures?limit=60");
    const box = document.getElementById("cap-list");
    const items = list.captures || [];
    if (!items.length) { box.innerHTML = '<div style="color:var(--dim);font-size:12px">Nothing captured yet.</div>'; return; }
    box.innerHTML = "";
    for (const e of items) {
      const row = document.createElement("div");
      row.style.cssText = "border:1px solid var(--line);border-radius:6px;padding:7px;margin-bottom:6px";
      const head = document.createElement("div");
      head.style.cssText = "display:flex;gap:6px;align-items:center;margin-bottom:4px";
      const name = document.createElement("span");
      name.textContent = e.filename;
      name.style.cssText = "flex:1;font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap";
      name.title = e.url;
      const conf = document.createElement("span");
      conf.className = "pill";
      conf.textContent = e.confidence;
      const btn = document.createElement("button");
      btn.textContent = "Get";
      btn.style.cssText = "padding:2px 8px;font-size:11px";
      btn.onclick = async () => {
        btn.disabled = true;
        try {
          await api("/api/tasks", { method: "POST", body: { url: e.url, filename: e.filename } });
          btn.textContent = "Queued"; toast("Queued " + e.filename, "ok"); refresh();
        } catch (err) { btn.disabled = false; toast(err.message, "err"); }
      };
      head.appendChild(name); head.appendChild(conf); head.appendChild(btn);
      const meta = document.createElement("div");
      meta.style.cssText = "font-size:11px;color:var(--dim);word-break:break-all";
      meta.textContent = (e.contentLength ? fmtBytes(e.contentLength) + " · " : "") + e.reason + (e.decrypted ? " · decrypted" : "");
      const link = document.createElement("div");
      link.style.cssText = "font-size:10px;color:var(--dim);word-break:break-all;margin-top:2px";
      link.textContent = e.url;
      row.appendChild(head); row.appendChild(meta); row.appendChild(link);
      box.appendChild(row);
    }
  } catch (err) {
    document.getElementById("cap-status").textContent = "error: " + err.message;
  }
}

document.getElementById("btnCapToggle").onclick = async () => {
  try {
    const st = await api("/api/proxy/status");
    const running = st.proxy && st.proxy.running;
    const mode = document.getElementById("cap-mode").value;
    if (running) await api("/api/proxy/stop", { method: "POST" });
    else await api("/api/proxy/start", { method: "POST", body: { mode } });
    capRefresh();
  } catch (err) { toast(err.message, "err"); }
};
document.getElementById("btnCapClear").onclick = async () => {
  try { await api("/api/proxy/captures/clear", { method: "POST" }); capRefresh(); } catch (err) { toast(err.message, "err"); }
};
document.getElementById("btnCaCreate").onclick = async () => {
  try {
    const r = await api("/api/proxy/ca", { method: "POST" });
    toast("CA created: " + r.certPath, "ok");
    capRefresh();
  } catch (err) { toast(err.message, "err"); }
};
document.getElementById("btnCaDestroy").onclick = async () => {
  try { await api("/api/proxy/ca/destroy", { method: "POST" }); toast("CA removed", "ok"); capRefresh(); }
  catch (err) { toast(err.message, "err"); }
};
document.getElementById("cap-autoqueue").onchange = async (ev) => {
  try {
    const cfg = (state.config || {}).captureProxy || {};
    await api("/api/config", { method: "PATCH", body: { captureProxy: { ...cfg, autoQueue: ev.target.checked } } });
    toast("Auto-queue " + (ev.target.checked ? "on" : "off"), "ok");
  } catch (err) { toast(err.message, "err"); }
};

/** Render the URL history, newest first. */
async function loadHistory() {
  const status = document.getElementById("hist-status");
  const box = document.getElementById("hist-list");
  const q = document.getElementById("hist-q").value.trim();
  try {
    const r = await api("/api/history?limit=60" + (q ? "&q=" + encodeURIComponent(q) : ""));
    if (r.available === false) {
      status.textContent = "history is not available in this session";
      box.innerHTML = "";
      return;
    }
    const entries = r.entries || [];
    if (!entries.length) {
      status.textContent = r.total
        ? "no entry matches that filter"
        : "nothing yet; every URL you queue is recorded here";
      box.innerHTML = "";
      return;
    }
    status.textContent = entries.length + " of " + r.total + " entr" + (r.total === 1 ? "y" : "ies");
    box.innerHTML = "";
    for (const e of entries) {
      const row = document.createElement("div");
      row.style.cssText = "border:1px solid var(--line);border-radius:6px;padding:7px;margin-bottom:6px";
      const head = document.createElement("div");
      head.style.cssText = "display:flex;gap:6px;align-items:center;margin-bottom:4px";
      const name = document.createElement("span");
      name.textContent = e.filename || e.url.split("/").pop() || e.url;
      name.style.cssText = "flex:1;font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap";
      name.title = e.url;
      const when = document.createElement("span");
      when.className = "pill";
      when.textContent = new Date(e.at).toLocaleDateString();
      const again = document.createElement("button");
      again.textContent = "Download again";
      again.style.cssText = "padding:2px 8px;font-size:11px";
      again.onclick = async () => {
        again.disabled = true;
        try {
          // The stored URL is sent as-is. It was redacted when it was recorded,
          // so a URL that carried a token has to be re-pasted from the site;
          // re-queueing the redacted form would silently fail at the origin.
          await api("/api/tasks", { method: "POST", body: { url: e.url, filename: e.filename || undefined } });
          toast("Queued " + (e.filename || e.url), "ok");
          refresh();
        } catch (err) { again.disabled = false; toast(err.message, "err"); }
      };
      head.appendChild(name); head.appendChild(when); head.appendChild(again);
      const link = document.createElement("div");
      link.style.cssText = "font-size:11px;color:var(--dim);word-break:break-all";
      link.textContent = e.url;
      row.appendChild(head); row.appendChild(link);
      box.appendChild(row);
    }
  } catch (err) {
    status.textContent = "error: " + err.message;
  }
}

async function loadLog() {
  try {
    const r = await api("/api/log?lines=300");
    const el = document.getElementById("logbox");
    el.textContent = (r.lines || []).join("\n") || "(no log lines yet)";
    el.scrollTop = el.scrollHeight;
  } catch { /* leave as-is */ }
}

async function loadSchedules() {
  const r = await api("/api/scheduler");
  const box = document.getElementById("schedList");
  const list = r.schedules || [];
  box.innerHTML = list.length
    ? list.map((s) => '<div style="display:flex;gap:8px;align-items:center;margin-bottom:6px;font-size:12px">' +
        '<span class="pill">' + esc(s.at || "—") + "</span><span>" + esc(s.action) + "</span>" +
        '<span style="color:var(--dim);flex:1">' + esc(s.name) + "</span>" +
        '<button data-sid="' + s.id + '">Del</button></div>').join("")
    : '<div style="color:var(--dim);font-size:12px">No schedules.</div>';
  box.querySelectorAll("button[data-sid]").forEach((b) => {
    b.onclick = async () => { await api("/api/scheduler/" + b.dataset.sid, { method: "DELETE" }); loadSchedules(); };
  });
}

document.getElementById("btnSniff").onclick = sniffPage;
document.getElementById("btnGrab").onclick = grabLinks;
document.getElementById("disc-url").addEventListener("keydown", (e) => { if (e.key === "Enter") sniffPage(); });

document.getElementById("btnHistRefresh").onclick = loadHistory;
document.getElementById("hist-q").addEventListener("keydown", (e) => { if (e.key === "Enter") loadHistory(); });
document.getElementById("btnHistClear").onclick = async () => {
  // Clearing history destroys something the user accumulated, so it is behind
  // an explicit confirmation and is never done automatically.
  if (!confirm("Delete the entire download history?\n\nThis cannot be undone. Your downloaded files are not affected.")) return;
  try {
    const r = await api("/api/history", { method: "DELETE" });
    toast("Removed " + r.removed + " history entr" + (r.removed === 1 ? "y" : "ies"), "ok");
    loadHistory();
  } catch (err) { toast(err.message, "err"); }
};

document.getElementById("btnAddSched").onclick = async () => {
  const at = document.getElementById("sched-at").value.trim();
  const action = document.getElementById("sched-action").value;
  const name = document.getElementById("sched-name").value.trim() || "schedule";
  try { await api("/api/scheduler", { method: "POST", body: { at, action, name } }); toast("Schedule added", "ok"); loadSchedules(); }
  catch (err) { toast(err.message, "err"); }
};

// Live updates over SSE; fall back to polling when the stream drops.
function connectEvents() {
  try {
    const es = new EventSource("/api/events?token=" + encodeURIComponent(TOKEN));
    es.onmessage = (ev) => {
      let msg = null;
      try { msg = JSON.parse(ev.data); } catch { return; }
      if (msg.type === "progress" && msg.payload) {
        const t = state.tasks.find((x) => x.id === msg.payload.taskId);
        if (t) {
          t.downloadedBytes = Math.round(msg.payload.bytesWritten || 0);
          // A streamed response keeps reporting totalBytes: null. Falling back
          // to the previous value would leave a stale total on screen, and
          // computing a percentage from it would be a fabrication, so the
          // "length unknown" flag is carried through instead.
          const streamed = msg.payload.lengthKnown === false;
          t.totalBytes = streamed ? null : (msg.payload.totalBytes || t.totalBytes || null);
          t.lengthKnown = !streamed && t.totalBytes !== null && t.totalBytes !== undefined;
          t.speed = msg.payload.speed || 0;
          t.percent = t.lengthKnown && t.totalBytes ? (t.downloadedBytes / t.totalBytes) * 100 : null;
          render();
        }
        return;
      }
      if (msg.type === "hello") return;
      refresh();
    };
    es.onerror = () => { es.close(); setTimeout(connectEvents, 4000); };
  } catch { /* polling covers it */ }
}

refresh();
setInterval(refresh, 2000);
setInterval(() => {
  const panel = document.getElementById("tab-capture");
  if (panel && panel.style.display !== "none") capRefresh();
}, 2500);
</script>
</body>
</html>
