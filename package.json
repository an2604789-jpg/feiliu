{
  "name": "feiliu",
  "version": "1.2.0",
  "description": "飞流 FeiLiu — concurrent segmented download manager (fork lineage: downloadx)",
  "type": "module",
  "license": "MIT",
  "main": "desktop/bootstrap.cjs",
  "bin": {
    "downloadx": "bin/downloadx.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/downloadx.mjs daemon",
    "gui": "node bin/downloadx.mjs open",
    "doctor": "node bin/downloadx.mjs doctor",
    "desktop": "electron .",
    "desktop:dir": "electron-builder --win --dir",
    "desktop:build": "electron-builder --win portable",
    "desktop:test": "node test/desktop.mjs",
    "desktop:e2e": "node test/desktop-e2e.mjs",
    "test": "node test/run.mjs",
    "test:large": "node test/large-file.mjs",
    "test:large:1g": "node test/large-file.mjs --size 1G",
    "install-extension": "node extension/install.mjs install",
    "uninstall-extension": "node extension/install.mjs uninstall",
    "host-status": "node extension/install.mjs status",
    "acceptance": "node test/acceptance.mjs",
    "acceptance:list": "node test/acceptance.mjs --list",
    "acceptance:real": "node test/acceptance-real.mjs",
    "desktop:launch": "node test/desktop-launch.mjs",
    "dist": "electron-builder --win nsis portable --linux AppImage deb --x64"
  },
  "files": [
    "bin",
    "src",
    "gui",
    "extension",
    "mcp",
    "test",
    "README.md",
    "Windows安装与首次使用.md",
    "验收流程说明.md"
  ],
  "build": {
    "appId": "com.downloadx.app",
    "productName": "飞流下载器",
    "copyright": "MIT License",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "!desktop/baseline/**",
      "bin/**/*",
      "src/**/*",
      "!src/**/*-bak",
      "gui/**/*",
      "extension/**/*",
      "package.json",
      "!**/*.md",
      "!test/**/*",
      "!build/**/*",
      "build/icon.ico",
      "!release/**/*",
      "mcp/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "DownloadX-Portable-${version}-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FeiLiu-Setup-${version}.${ext}"
    },
    "linux": {
      "artifactName": "FeiLiu-${version}.${ext}",
      "category": "Network",
      "maintainer": "feiliu contributors"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
